# N-Fizyo – Beispiel-Konfiguration
# Kopieren nach .env und anpassen. Passwörter, Schlüssel und Tokens NIE in den Chat oder ins Git.

# Geheimer Schlüssel für Sitzungen und signierte Links (wird von deploy/install.sh automatisch erzeugt)
NFIZYO_SECRET_KEY=

# Wo Datenbank, Audio und Dokumente liegen
NFIZYO_DATA_DIR=/var/lib/n-fizyo

# Webserver (hinter Caddy/nginx). 127.0.0.1 = nur lokal erreichbar
NFIZYO_HOST=127.0.0.1
NFIZYO_PORT=8080
NFIZYO_BASE_URL=https://n-fizyo.local

# Demo-Modus: legt eine Demo-Praxis mit fiktiven Daten an. In echten Praxen: 0
NFIZYO_DEMO=0

NFIZYO_DEFAULT_LANG=de
# Zeitzone: fest Europe/Zurich (Termine, Kassentag, Fristen) – keine Einstellung nötig.

# --- Lokale KI ---------------------------------------------------------------
# Spracherkennung: none | faster_whisper
NFIZYO_STT=none
# Modellname oder Pfad zu einem CTranslate2-Modell (z. B. Schweizerdeutsch-Feintuning)
NFIZYO_STT_MODEL=large-v3-turbo
# cpu | cuda
NFIZYO_STT_DEVICE=cuda

# Notizentwurf und Berichtsauswertung: rules | ollama
NFIZYO_LLM=rules
NFIZYO_LLM_MODEL=qwen2.5:7b-instruct
NFIZYO_OLLAMA_URL=http://127.0.0.1:11434

# Übersetzung für Patientinnen und Patienten (Anliegen, Nachrichten, Heimprogramm, Dolmetscher)
# none | ollama  – Modell z. B. translategemma:12b (Google, Gemma-Lizenz, 55 Sprachen, ~8–12 GB GPU-Speicher)
NFIZYO_TRANSLATE=none
NFIZYO_TRANSLATE_MODEL=translategemma:12b

# Sicherheit: KI-Dienste nur im lokalen Netz erlauben. Nur für Tests auf 1 setzen.
NFIZYO_ALLOW_REMOTE_AI=0

# Gemeinsamer KI-Server in der Schweiz (GPU, von NSystem betrieben) statt lokaler KI – setzt install.sh --ai-server.
# Der Token kommt von NSystem und steht nur hier (nie im Chat, nie in E-Mails).
# NFIZYO_AI_MODE=remote
# NFIZYO_AI_SERVER_URL=https://ki.beispiel.ch
# NFIZYO_AI_TOKEN=

# NUR Vorführung auf einem Laptop (NFIZYO_DEMO=1, fiktive Daten): externer KI-Dienst, Anleitung docs/AI.md.
# Ohne NFIZYO_DEMO=1 startet N-Fizyo damit nicht. Für echte Praxen nie verwenden.
# NFIZYO_AI_MODE=cloud_demo
# NFIZYO_CLOUD_AI_URL=https://api.mistral.ai/v1
# NFIZYO_CLOUD_AI_KEY=
# NFIZYO_CLOUD_AI_STT_MODEL=voxtral-mini-transcribe-3
# NFIZYO_CLOUD_AI_LLM_MODEL=mistral-small-latest
# NFIZYO_CLOUD_AI_TRANSLATE_MODEL=
# NFIZYO_CLOUD_AI_REASONING=none
# NFIZYO_CLOUD_AI_TIMEOUT=60

# Gescannte Berichte: Scanner legt PDFs in NFIZYO_DATA_DIR/scan-eingang/<praxis-kurzname>/ ab.
# N-Fizyo liest sie automatisch ein (Texterkennung mit Tesseract, falls installiert).

# Audioaufnahmen nach dem Bestätigen der Notiz löschen (empfohlen)
NFIZYO_DELETE_AUDIO_AFTER_APPROVAL=1

# Zwei-Schritt-Anmeldung (Authenticator-App) für alle Praxiskonten. In echten Praxen immer 1.
NFIZYO_REQUIRE_2FA=1

# --- SMS: log (nur Postausgang, nichts wird versendet) | live (Anbieter laut Einstellungen › SMS) -----
NFIZYO_SMS=log
NFIZYO_ASPSMS_USERKEY=
NFIZYO_ASPSMS_PASSWORD=
NFIZYO_ECALL_USERNAME=
NFIZYO_ECALL_PASSWORD=

# --- E-Mail an Patient/innen (nur mit Einverständnis): log = nichts versenden | live = SMTP ------
NFIZYO_MAIL=log
NFIZYO_SMTP_HOST=
NFIZYO_SMTP_PORT=587
NFIZYO_SMTP_TLS=starttls
NFIZYO_SMTP_USER=
NFIZYO_SMTP_PASSWORD=
NFIZYO_SMTP_FROM=

# --- HIN (über den HIN Client auf dem Server) ---------------------------------------------------
NFIZYO_HIN_PRACTICE=
NFIZYO_HIN_FROM=
NFIZYO_HIN_SMTP_HOST=127.0.0.1
NFIZYO_HIN_SMTP_PORT=5018
NFIZYO_HIN_IMAP_HOST=127.0.0.1
NFIZYO_HIN_IMAP_PORT=5020
NFIZYO_HIN_TLS=none
NFIZYO_HIN_USER=
NFIZYO_HIN_PASSWORD=
NFIZYO_HIN_POLL_MINUTES=5

# --- MediData (elektronische Rechnung): off | test | production -------------------------------
NFIZYO_MEDIDATA=off
NFIZYO_MEDIDATA_URL=
NFIZYO_MEDIDATA_CLIENT_ID=
NFIZYO_MEDIDATA_USER=
NFIZYO_MEDIDATA_PASSWORD=

# --- NSystem-Übersicht (wird von deploy/connect-central.sh eingetragen) -------------------------
NFIZYO_CENTRAL_URL=
NFIZYO_CENTRAL_BOX_ID=
NFIZYO_CENTRAL_BOX_KEY=
NFIZYO_CENTRAL_COMMAND_PUBKEY=
# Neue Versionen für den Befehl «Neue Version» nur von hier (https) und nur signiert mit dem Release-Schlüssel von NSystem
NFIZYO_RELEASE_BASE=
# öffentlicher Release-Schlüssel (nicht geheim; tools/release.py pubkey)
NFIZYO_RELEASE_PUBKEY=

# --- Supportzugang (optional; deploy/connect-central.sh trägt es aus support-bx_….env ein, docs/MERKEZ.md) ---------------
# Öffnen kann ihn nur die Leitung (Einstellungen › NSystem). Alles öffentliche Werte.
NFIZYO_SUPPORT_HUB=
NFIZYO_SUPPORT_HUB_PUBKEY=
NFIZYO_SUPPORT_ADDRESS=
NFIZYO_SUPPORT_HUB_IP=10.77.0.1
NFIZYO_SUPPORT_SSH_KEYS=

# --- Externe verschlüsselte Sicherung (optional, Anleitung docs/YEDEK.md) -----------------------
# Ziel: rclone:<remote>:<pfad>  |  benutzer@host:/pfad (rsync über SSH)  |  /mnt/ordner (eingehängtes Laufwerk)
# Leer = keine externe Kopie. Jeder Satz wird vor dem Hochladen mit GnuPG (AES-256) verschlüsselt.
NFIZYO_OFFSITE_TARGET=
# Passphrase-Datei: nur root, chmod 600 – erzeugen mit: sudo n-fizyo-backup --offsite-keygen
NFIZYO_OFFSITE_KEY_FILE=/etc/n-fizyo/offsite.key
# So viele Sätze bleiben am Ziel liegen (ältere werden dort gelöscht)
NFIZYO_OFFSITE_KEEP=14
# Nur rsync/SSH: eigener SSH-Schlüssel (nur root)
NFIZYO_OFFSITE_SSH_KEY=
# Nur rclone: Konfigurationsdatei (Standard: /root/.config/rclone/rclone.conf)
NFIZYO_OFFSITE_RCLONE_CONFIG=
